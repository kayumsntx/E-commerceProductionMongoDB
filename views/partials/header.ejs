<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GIFTYPACK.COM</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        /* ============================================
           RESET & BASE
           ============================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ============================================
           MAIN NAVBAR – প্রফেশনাল
           ============================================ */
        .main-navbar {
            background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 32px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
            position: sticky;
            top: 0;
            z-index: 1000;
            gap: 16px;
            flex-wrap: nowrap;
            min-height: 64px;
            border-bottom: 2px solid rgba(243, 156, 18, 0.15);
        }

        /* ===== LOGO ===== */
        .nav-brand-container {
            display: flex;
            align-items: center;
            text-decoration: none;
            gap: 10px;
            flex-shrink: 0;
        }

        .header-logo {
            height: 40px;
            width: auto;
            object-fit: contain;
            display: block;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
        }

        .nav-brand {
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #f39c12, #e67e22);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            white-space: nowrap;
        }

        /* ===== SEARCH BOX ===== */
        .header-search-box {
            flex: 0 1 260px;
            min-width: 140px;
            position: relative;
        }

        .header-search-box input {
            width: 100%;
            padding: 7px 14px 7px 36px;
            background: rgba(255, 255, 255, 0.08);
            border: 1.5px solid transparent;
            border-radius: 50px;
            color: #fff;
            font-size: 0.85rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .header-search-box input::placeholder {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.8rem;
        }

        .header-search-box input:focus {
            background: rgba(255, 255, 255, 0.14);
            border-color: #f39c12;
            box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.15);
        }

        .search-icon-placeholder {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.8rem;
            pointer-events: none;
        }

        /* ===== NAV LINKS ===== */
        .nav-links {
            display: flex;
            align-items: center;
            gap: 2px;
            list-style: none;
            margin: 0;
            padding: 0;
            flex-wrap: nowrap;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .nav-links::-webkit-scrollbar {
            height: 0;
        }

        .nav-links li {
            display: flex;
            align-items: center;
            flex-shrink: 0;
        }

        .nav-links a,
        .nav-links .dropdown-toggle {
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            font-weight: 500;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.82rem;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.25s ease;
            white-space: nowrap;
            background: transparent;
            border: none;
            cursor: pointer;
            font-family: inherit;
        }

        .nav-links a:hover,
        .nav-links .dropdown-toggle:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
        }

        .nav-links a i,
        .nav-links .dropdown-toggle i {
            font-size: 0.85rem;
            opacity: 0.7;
        }

        /* ===== CUSTOM DROPDOWN (Categories) ===== */
        .custom-dropdown {
            position: relative;
            display: inline-block;
        }

        .custom-dropdown .dropdown-toggle {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 6px 16px 6px 14px;
            border-radius: 50px;
            font-size: 0.82rem;
            color: rgba(255, 255, 255, 0.8);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.25s ease;
        }

        .custom-dropdown .dropdown-toggle:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(243, 156, 18, 0.4);
            color: #fff;
        }

        .custom-dropdown .dropdown-toggle i {
            font-size: 0.8rem;
            opacity: 0.6;
        }

        .custom-dropdown .dropdown-menu {
            display: none;
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            min-width: 220px;
            background: #1a202c;
            border-radius: 12px;
            padding: 6px 0;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.06);
            z-index: 1100;
        }

        .custom-dropdown .dropdown-menu.show {
            display: block;
            animation: fadeDown 0.2s ease;
        }

        @keyframes fadeDown {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .custom-dropdown .dropdown-menu a,
        .custom-dropdown .dropdown-menu .dropdown-item {
            display: block;
            padding: 8px 20px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            font-size: 0.85rem;
            transition: background 0.15s ease;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            cursor: pointer;
        }

        .custom-dropdown .dropdown-menu a:hover,
        .custom-dropdown .dropdown-menu .dropdown-item:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
        }

        .custom-dropdown .dropdown-menu .divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.06);
            margin: 4px 12px;
        }

        .custom-dropdown .dropdown-menu .optgroup-label {
            padding: 6px 20px 2px;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: rgba(255, 255, 255, 0.3);
            font-weight: 600;
        }

        /* ===== CART LINK ===== */
        .nav-cart-link {
            background: rgba(243, 156, 18, 0.15) !important;
            border: 1px solid rgba(243, 156, 18, 0.25) !important;
            padding: 6px 16px !important;
            border-radius: 50px !important;
        }

        .nav-cart-link:hover {
            background: rgba(243, 156, 18, 0.25) !important;
        }

        .nav-cart-link .cart-badge {
            background: #e74c3c;
            color: #fff;
            border-radius: 50%;
            padding: 1px 7px;
            font-size: 0.6rem;
            font-weight: 700;
            min-width: 18px;
            text-align: center;
            display: inline-block;
            margin-left: 4px;
            animation: pulse-badge 2s infinite;
        }

        .nav-cart-link .cart-badge.zero {
            background: #718096;
            animation: none;
        }

        @keyframes pulse-badge {
            0%,
            100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.1);
            }
        }

        /* ===== BUTTONS ===== */
        .btn-login {
            background: linear-gradient(135deg, #f39c12, #e67e22) !important;
            color: #fff !important;
            font-weight: 600 !important;
            padding: 6px 18px !important;
            border-radius: 50px !important;
            border: none !important;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(243, 156, 18, 0.35) !important;
            background: linear-gradient(135deg, #f39c12, #d68910) !important;
        }

        .btn-logout {
            background: rgba(229, 62, 62, 0.9) !important;
            color: #fff !important;
            padding: 6px 16px !important;
            border-radius: 50px !important;
            border: none !important;
        }

        .btn-logout:hover {
            background: #c0392b !important;
        }

        .user-name-display {
            color: #f39c12 !important;
            font-weight: 600;
            padding: 6px 12px !important;
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 0.8rem;
        }

        .super-admin-badge {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            color: #fff;
            padding: 1px 10px;
            border-radius: 20px;
            font-size: 0.55rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-left: 6px;
            display: inline-block;
        }

        /* ===== GUEST CART BANNER ===== */
        .guest-cart-banner {
            background: #ebf8ff;
            padding: 6px 20px;
            text-align: center;
            border-bottom: 1px solid #bee3f8;
            font-size: 0.85rem;
            color: #2a69ac;
        }

        .guest-cart-banner a {
            color: #2b6cb0;
            font-weight: 600;
            margin-left: 8px;
        }

        .guest-cart-banner a:hover {
            text-decoration: underline;
        }

        /* ===== NOTIFICATION ===== */
        #notificationContainer {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 400px;
        }

        .notification {
            padding: 14px 20px;
            border-radius: 12px;
            color: #fff;
            font-weight: 500;
            animation: slideIn 0.4s ease;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .notification-success {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
        }
        .notification-info {
            background: linear-gradient(135deg, #2980b9, #3498db);
        }
        .notification-warning {
            background: linear-gradient(135deg, #f39c12, #e67e22);
        }
        .notification-error {
            background: linear-gradient(135deg, #c0392b, #e74c3c);
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* ============================================
           RESPONSIVE
           ============================================ */
        @media (max-width: 1024px) {
            .main-navbar {
                padding: 8px 18px;
                gap: 12px;
            }
            .header-search-box {
                flex: 0 1 180px;
                min-width: 120px;
            }
            .nav-links a,
            .nav-links .dropdown-toggle,
            .custom-dropdown .dropdown-toggle {
                font-size: 0.75rem;
                padding: 5px 10px;
            }
        }

        @media (max-width: 820px) {
            .main-navbar {
                flex-wrap: wrap;
                padding: 8px 16px;
                gap: 6px;
            }
            .nav-brand-container {
                flex-shrink: 0;
            }
            .header-search-box {
                flex: 1 1 100%;
                order: 3;
                min-width: unset;
            }
            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: 2px;
            }
            .nav-links a,
            .nav-links .dropdown-toggle,
            .custom-dropdown .dropdown-toggle {
                font-size: 0.7rem;
                padding: 4px 8px;
            }
            .nav-cart-link .cart-text {
                display: none;
            }
            .custom-dropdown .dropdown-menu {
                left: 50%;
                transform: translateX(-50%);
                min-width: 200px;
            }
        }

        @media (max-width: 480px) {
            .main-navbar {
                padding: 6px 10px;
            }
            .nav-brand {
                font-size: 1rem;
            }
            .header-logo {
                height: 30px;
            }
            .nav-links a,
            .nav-links .dropdown-toggle,
            .custom-dropdown .dropdown-toggle {
                font-size: 0.65rem;
                padding: 3px 6px;
            }
            .nav-links a i,
            .nav-links .dropdown-toggle i {
                font-size: 0.7rem;
            }
            .nav-cart-link {
                padding: 3px 8px !important;
            }
            .header-search-box input {
                font-size: 0.7rem;
                padding: 5px 10px 5px 28px;
            }
            .btn-login,
            .btn-logout {
                font-size: 0.65rem !important;
                padding: 3px 10px !important;
            }
            .custom-dropdown .dropdown-toggle {
                font-size: 0.65rem;
                padding: 3px 10px 3px 8px;
            }
            .custom-dropdown .dropdown-menu {
                min-width: 160px;
                left: 0;
                transform: none;
            }
        }
    </style>
</head>

<body>

    <!-- ============================================ -->
    <!-- NAVBAR -->
    <!-- ============================================ -->
    <nav class="main-navbar">

        <!-- Logo -->
        <a href="/" class="nav-brand-container">
            <img src="https://res.cloudinary.com/o4zunnbp/image/upload/v1783692811/GIFTYPACKLOGO_mc4kpm.png" alt="GIFTYPACK Logo" class="header-logo" />
            <span class="nav-brand">GIFTYPACK</span>
        </a>

        <!-- Search -->
        <div class="header-search-box">
            <span class="search-icon-placeholder">🔍</span>
            <input type="text" id="globalProductSearch" placeholder="Search..." autocomplete="off" />
        </div>

        <!-- ===== NAV LINKS ===== -->
        <ul class="nav-links">

            <!-- Home -->
            <li><a href="/"><i class="fas fa-home"></i> Home</a></li>

            <!-- Become a Seller -->
            <li><a href="/become-a-seller"><i class="fas fa-user-plus"></i> Seller</a></li>

            <!-- Make a Custom Order (visible to logged-in users only) -->
            <% if (typeof user !== 'undefined' && user) { %>
                <li><a href="/custom-orders"><i class="fas fa-edit"></i> Custom Order</a></li>
            <% } %>

            <!-- ===== Categories Dropdown (Custom) ===== -->
            <li class="custom-dropdown">
                <button class="dropdown-toggle" id="categoriesToggle">
                    <i class="fas fa-boxes"></i> Categories <i class="fas fa-chevron-down" style="font-size:0.6rem;margin-left:2px;"></i>
                </button>
                <div class="dropdown-menu" id="categoriesMenu">
                    <a href="/category/shopping-bags">Shopping Bag's</a>
                    <a href="/category/courier-poly">Courier Poly</a>
                    <a href="/category/stickers">Sticker's</a>
                    <a href="/category/bubble-wrap">Bubble Wrap</a>
                    <a href="/category/cards">Card's</a>
                    <a href="/category/scotch-tape">Scotch Tape</a>
                    <div class="divider"></div>
                    <div class="optgroup-label">Box's</div>
                    <a href="/category/curtain-box">1. Curtain Box</a>
                    <a href="/category/curtain-premium-box">2. Curtain Premium Box</a>
                    <a href="/category/premium-box">3. Premium Box</a>
                </div>
            </li>

            <!-- Custom Order links (additional) -->
            <% if (typeof user !== 'undefined' && user) { %>
                <li><a href="/my-custom-orders"><i class="fas fa-list-ul"></i> My Orders</a></li>
            <% } %>

            <!-- Admin: Custom Orders Management -->
            <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.username.toLowerCase() === 'admin' || user.isSuperAdmin === true)) { %>
                <li><a href="/admin/custom-orders"><i class="fas fa-clipboard-list"></i> Custom Mgmt</a></li>
            <% } %>

            <!-- Seller: Bid on Orders -->
            <% if (typeof user !== 'undefined' && user && (user.role === 'seller' || user.role === 'authorized_cashier' || user.isSuperAdmin === true)) { %>
                <li><a href="/seller/custom-orders"><i class="fas fa-gavel"></i> Bid</a></li>
            <% } %>

            <!-- Terminal (cashier/admin) -->
            <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'authorized_cashier' || user.username.toLowerCase() === 'admin' || user.isSuperAdmin === true)) { %>
                <li><a href="/terminal"><i class="fas fa-cash-register"></i> Terminal</a></li>
            <% } %>

            <!-- My Orders (regular user) -->
            <% if (typeof user !== 'undefined' && user) { %>
                <li><a href="/my-orders"><i class="fas fa-box"></i> Orders</a></li>
            <% } %>

            <!-- Cart -->
            <li>
                <a href="/cart" class="nav-cart-link" id="cartLink">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-text">Cart</span>
                    <span class="cart-badge zero" id="cartCount">0</span>
                </a>
            </li>

            <!-- Super Admin -->
            <% if (typeof user !== 'undefined' && user && (user.username === 'superadmin' || user.isSuperAdmin === true)) { %>
                <li>
                    <a href="/superadmin/dashboard" style="background: linear-gradient(135deg, #f39c12, #e67e22); color: #fff !important; font-weight: 700; border-radius: 50px; padding: 4px 14px; font-size: 0.7rem;">
                        <i class="fas fa-crown"></i> Super
                    </a>
                </li>
            <% } %>

            <!-- Admin: Order Management, Inventory, Sales, Stock, Users -->
            <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.username.toLowerCase() === 'admin' || user.isSuperAdmin === true)) { %>
                <li><a href="/admin/orders"><i class="fas fa-clipboard-list"></i> Orders</a></li>
                <li><a href="/admin/inventory"><i class="fas fa-warehouse"></i> Inventory</a></li>
                <li><a href="/sales"><i class="fas fa-chart-bar"></i> Sales</a></li>
                <li><a href="/admin/stock-report"><i class="fas fa-boxes"></i> Stock</a></li>
                <li><a href="/admin/users"><i class="fas fa-users"></i> Users</a></li>
            <% } %>

            <!-- Super Admin: Admins -->
            <% if (typeof user !== 'undefined' && user && (user.username === 'superadmin' || user.isSuperAdmin === true)) { %>
                <li><a href="/superadmin/admins"><i class="fas fa-user-shield"></i> Admins</a></li>
            <% } %>

            <!-- User Profile / Login / Logout -->
            <% if (typeof user !== 'undefined' && user) { %>
                <li>
                    <a href="/profile" class="user-name-display">
                        <i class="fas fa-user-circle"></i> <%= user.username %>
                        <% if (user.isSuperAdmin === true || user.username === 'superadmin') { %>
                            <span class="super-admin-badge">Super</span>
                        <% } %>
                    </a>
                </li>
                <li><a href="/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
            <% } else { %>
                <li><a href="/login" class="btn-login"><i class="fas fa-sign-in-alt"></i> Login</a></li>
            <% } %>

        </ul>
    </nav>

    <!-- Guest Cart Banner -->
    <% if (typeof user === 'undefined' || !user) { %>
        <div class="guest-cart-banner">
            <i class="fas fa-shopping-cart"></i>
            You have <strong id="guestCartCount">0</strong> items in your cart.
            <a href="/login">Login to Checkout <i class="fas fa-arrow-right"></i></a>
        </div>
    <% } %>

    <!-- Notification Container -->
    <div id="notificationContainer"></div>

    <!-- ============================================ -->
    <!-- SCRIPTS -->
    <!-- ============================================ -->
    <script>
        $(document).ready(function() {

            // ===== CATEGORIES DROPDOWN TOGGLE =====
            $('#categoriesToggle').on('click', function(e) {
                e.stopPropagation();
                $('#categoriesMenu').toggleClass('show');
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('.custom-dropdown').length) {
                    $('#categoriesMenu').removeClass('show');
                }
            });

            // ===== SEARCH =====
            $('#globalProductSearch').on('keyup', function() {
                var searchString = $(this).val().toLowerCase().trim();
                $('.log-container table tbody tr').filter(function() {
                    var receiptCode = $(this).find('td:nth-child(1)').text().toLowerCase();
                    var productName = $(this).find('td:nth-child(3)').text().toLowerCase();
                    var isMatch = (receiptCode.indexOf(searchString) > -1) || (productName.indexOf(searchString) >
                    -1);
                    $(this).toggle(isMatch);
                });
                $('.home-catalog-grid .home-card').filter(function() {
                    var productNameText = $(this).find('strong').text().toLowerCase();
                    $(this).toggle(productNameText.indexOf(searchString) > -1);
                });
                $('.product-grid .card').filter(function() {
                    var terminalItemText = $(this).find('strong').text().toLowerCase();
                    $(this).toggle(terminalItemText.indexOf(searchString) > -1);
                });
                $('.admin-inventory-grid .card').filter(function() {
                    var catalogItemText = $(this).find('.card-body strong').text().toLowerCase();
                    $(this).toggle(catalogItemText.indexOf(searchString) > -1);
                });
            });

            // ===== CART COUNT =====
            window.updateCartCount = function() {
                $.ajax({
                    url: '/api/cart/view',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            var count = response.count || 0;
                            var $badge = $('#cartCount');
                            $badge.text(count);
                            $('#guestCartCount').text(count);
                            if (count === 0) {
                                $badge.addClass('zero');
                            } else {
                                $badge.removeClass('zero');
                            }
                        }
                    },
                    error: function() {
                        console.log('Cart count update failed');
                    }
                });
            };

            // ===== NOTIFICATION =====
            window.showNotification = function(message, type, icon) {
                var container = $('#notificationContainer');
                var icons = {
                    success: 'fa-check-circle',
                    info: 'fa-info-circle',
                    warning: 'fa-exclamation-triangle',
                    error: 'fa-times-circle'
                };
                var notification = $(
                    '<div class="notification notification-' + type + '">' +
                    '<i class="fas ' + (icons[type] || 'fa-info-circle') + '"></i>' +
                    '<span>' + message + '</span>' +
                    '</div>'
                );
                container.append(notification);
                setTimeout(function() {
                    notification.fadeOut(300, function() { $(this).remove(); });
                }, 3000);
            };

            // ===== INIT =====
            if (typeof updateCartCount === 'function') {
                updateCartCount();
            }

            console.log('✅ Professional Header Loaded');
        });
    </script>

</body>
</html>