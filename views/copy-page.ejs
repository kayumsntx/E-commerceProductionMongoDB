import { HttpClient } from '@angular/common/http';
import { Injectable, inject } from '@angular/core';
import { Observable } from 'rxjs';
import { Employee } from '../models/employee';
import { TrainingRecord } from '../models/training-record';
import { TrainingDTO } from '../models/training-dto';
@Injectable({ providedIn: 'root' })
export class EmployeeService {
private apiUrl = 'http://localhost:5188/api/Employees';
private http = inject(HttpClient);
getEmployees(): Observable<Employee[]> {
return this.http.get<Employee[]>(this.apiUrl);
}
getEmployeeById(id: number): Observable<Employee> {
return this.http.get<Employee>(`${this.apiUrl}/${id}`);
}

getTrainingRecords(): Observable<TrainingRecord[]> {
return this.http.get<TrainingRecord[]>(`${this.apiUrl}/records`);
}
saveEmployee(
employeeData: any,
imageFile: File | null,
trainings: TrainingDTO[],
): Observable<Employee> {
const formData = this.buildFormData(employeeData, imageFile, trainings);
return this.http.post<Employee>(this.apiUrl, formData);
}
updateEmployee(
id: number,
employeeData: any,
imageFile: File | null,
trainings: TrainingDTO[],
): Observable<void> {
const formData = this.buildFormData(employeeData, imageFile, trainings);
formData.append('EmployeeId', id.toString());
return this.http.put<void>(`${this.apiUrl}/${id}`, formData);
}
deleteEmployee(id: number): Observable<void> {
return this.http.delete<void>(`${this.apiUrl}/${id}`);
}

private buildFormData(data: any, imageFile: File | null, trainings: TrainingDTO[]): FormData
{
const formData = new FormData();
formData.append('EmployeeName', data.employeeName);
formData.append('IsActive', data.isActive ? 'true' : 'false');
formData.append('JoinDate', data.joinDate);
if (imageFile) {
formData.append('ImageFile', imageFile);
}
formData.append('TrainingsString', JSON.stringify(trainings));
return formData;
}
}




