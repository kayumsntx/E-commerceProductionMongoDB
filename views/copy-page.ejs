<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Copy Text</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .copy-container {
            text-align: center;
            max-width: 500px;
            width: 100%;
        }

        .copy-btn {
            background: #f7fafc;
            color: #a0aec0;
            border: 1px solid #e2e8f0;
            padding: 10px 28px;
            border-radius: 4px;
            font-weight: 400;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            letter-spacing: 0.3px;
        }

        .copy-btn:hover {
            background: #f0f2f5;
            border-color: #cbd5e0;
            color: #718096;
        }

        .copy-btn:active {
            transform: scale(0.97);
        }

        .copy-btn.copied {
            background: #f7fafc;
            border-color: #cbd5e0;
            color: #718096;
        }

        .copy-btn i {
            font-size: 0.8rem;
            opacity: 0.5;
        }

        .copy-status {
            display: block;
            margin-top: 10px;
            font-size: 0.7rem;
            color: #e2e8f0;
            transition: color 0.3s ease;
            letter-spacing: 0.5px;
        }

        .copy-status.success {
            color: #e2e8f0;
        }

        .copy-text-label {
            font-size: 0.7rem;
            color: #edf2f7;
            margin-bottom: 12px;
            letter-spacing: 1px;
            font-weight: 300;
        }

        .copy-text-label i {
            margin-right: 4px;
            opacity: 0.3;
        }
    </style>
</head>
<body>

    <div class="copy-container">
        <div class="copy-text-label">
            <i class="fas fa-copy"></i> copy text
        </div>

        <button class="copy-btn" id="copyBtn">
            <i class="fas fa-copy"></i>
            <span id="copyBtnText">copy</span>
        </button>

        <span class="copy-status" id="copyStatus">ready</span>
    </div>

    <script>
        // ============================================
        // আপনার কাস্টম টেক্সট (এখানে যা লিখবেন তাই কপি হবে)
        // ============================================
        const customText = `
==========================================
🚀 BAGNEST - Custom Text
==========================================

📅 Date: ${new Date().toLocaleString()}
🌐 URL: ${window.location.href}

==========================================
📝 YOUR MESSAGE
==========================================

আপনি এখানে যেকোনো টেক্সট লিখতে পারেন।
এটি কপি হবে যখন বাটনে ক্লিক করবেন।

==========================================
🛠️ BAGNEST v1.0.0
==========================================
        `;

        // ============================================
        // COPY FUNCTION
        // ============================================
        async function copyCustomText() {
            const btn = document.getElementById('copyBtn');
            const btnText = document.getElementById('copyBtnText');
            const status = document.getElementById('copyStatus');

            try {
                await navigator.clipboard.writeText(customText);

                btn.classList.add('copied');
                btnText.textContent = 'copied';
                status.textContent = '✓ copied';
                status.className = 'copy-status success';

                setTimeout(() => {
                    btn.classList.remove('copied');
                    btnText.textContent = 'copy';
                    status.textContent = 'ready';
                    status.className = 'copy-status';
                }, 1500);

            } catch (err) {
                // Fallback for older browsers
                const textArea = document.createElement('textarea');
                textArea.value = customText;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);

                btn.classList.add('copied');
                btnText.textContent = 'copied';
                status.textContent = '✓ copied';
                status.className = 'copy-status success';

                setTimeout(() => {
                    btn.classList.remove('copied');
                    btnText.textContent = 'copy';
                    status.textContent = 'ready';
                    status.className = 'copy-status';
                }, 1500);
            }
        }

        // ============================================
        // EVENT LISTENERS
        // ============================================
        document.getElementById('copyBtn').addEventListener('click', copyCustomText);

        // Keyboard shortcut: Ctrl+C
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'c' && e.target === document.body) {
                e.preventDefault();
                copyCustomText();
            }
        });

        console.log('✅ Copy Page Loaded');
    </script>

</body>
</html>