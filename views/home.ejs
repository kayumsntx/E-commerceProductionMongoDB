<!-- ============================================ -->
<!-- ইউজার স্ট্যাটাস বার (নতুন যোগ করা) -->
<!-- ============================================ -->
<% if (typeof user !== 'undefined' && user) { %>
    <div style="background: #27ae60; color: white; padding: 12px 20px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
        <div>
            <i class="fas fa-check-circle"></i> 
            <strong>Welcome back, <%= user.username %>!</strong> 
            <span style="opacity: 0.8; margin-left: 10px;">
                <% if (user.isSuperAdmin || user.username === 'superadmin') { %>
                    👑 Super Admin
                <% } else { %>
                    <%= user.role %>
                <% } %>
            </span>
        </div>
        <div>
            <a href="/profile" style="color: white; text-decoration: underline; margin-right: 15px;">
                <i class="fas fa-user"></i> Profile
            </a>
            <a href="/logout" style="color: white; background: rgba(255,255,255,0.2); padding: 5px 15px; border-radius: 5px; text-decoration: none;">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>
<% } else { %>
    <div style="background: #f39c12; color: white; padding: 12px 20px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
        <div>
            <i class="fas fa-info-circle"></i> 
            <strong>You are browsing as a guest.</strong>
            <span style="opacity: 0.8; margin-left: 10px;">Login to manage your orders</span>
        </div>
        <div>
            <a href="/login" style="color: white; background: rgba(255,255,255,0.2); padding: 5px 15px; border-radius: 5px; text-decoration: none;">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
            <a href="/register" style="color: white; margin-left: 10px; text-decoration: underline;">
                Register
            </a>
        </div>
    </div>
<% } %>